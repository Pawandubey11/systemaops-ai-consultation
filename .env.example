# Copy this file to .env and fill in the values.
# Never commit .env — it is listed in .gitignore.

PORT=3000
MONGODB_URI=
CONSULTATION_EMAIL=hello@systemaops.com

# Python executable for PDF generation
# Windows:    PDF_PYTHON=python
# Linux/macOS: PDF_PYTHON=python3
# Docker:     leave blank (python3 is auto-available inside the container)
PDF_PYTHON=python3

# Dify AI — get your key from https://cloud.dify.ai → App → API Access
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_APP_TYPE=chatflow
DIFY_INPUT_NAME=consultation_json
DIFY_OUTPUT_NAME=analysis
DIFY_TIMEOUT_MS=90000
DIFY_MAX_RETRIES=2
# true  = deterministic fallback if Dify fails (good for dev/demo)
# false = strict mode — consultations fail if Dify is unavailable (use in production)
DIFY_FALLBACK_ENABLED=true

# Rate limiting — max consultation submissions per minute per IP
CONSULTATION_RATE_LIMIT=10

# CORS — comma-separated list of allowed origins (leave blank to allow localhost only)
CORS_ORIGINS=http://localhost:3000,https://systemaops.com
