# Copy this file to .env and fill in the values.
# Never commit .env — it is listed in .gitignore.

PORT=3000
MONGODB_URI=
CONSULTATION_EMAIL=hello@systemaops.com

# Python executable for PDF generation (leave blank to use system python3)
PDF_PYTHON=

# Dify AI
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_APP_TYPE=chatflow
DIFY_INPUT_NAME=consultation_json
DIFY_OUTPUT_NAME=analysis
DIFY_TIMEOUT_MS=90000
DIFY_MAX_RETRIES=2
# Set to true during development or when Dify may be temporarily unavailable
DIFY_FALLBACK_ENABLED=true

# Rate limiting — max consultation submissions per 15 min window per IP
CONSULTATION_RATE_LIMIT=10

# CORS — comma-separated list of allowed origins (leave blank to allow all)
CORS_ORIGINS=http://localhost:3000,https://systemaops.com
